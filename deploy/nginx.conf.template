server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # Resolve the service again after the backend container is recreated.
    resolver 127.0.0.11 valid=5s ipv6=off;
    set $backend_origin "${BACKEND_ORIGIN}";

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location ~ ^/api(?:/|$) {
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_next_upstream off;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /api-unavailable;
    }

    location = /api-unavailable {
        internal;
        default_type application/json;
        return 503 '{"error":{"code":"BACKEND_UNAVAILABLE","message":"Сервер помощника временно недоступен. Повторите запрос."}}';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
