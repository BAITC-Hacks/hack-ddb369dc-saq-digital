# Optional: the application works offline without this file.
APP_MODE=offline
PORT=3001
FRONTEND_PORT=5173
# Published Docker port (independent of the backend's PORT).
APP_PORT=8080
# APP_IMAGE=ekt-match:local

# OpenAI is enabled with APP_MODE=live and a populated key.
# Keep credentials in the local .env or deployment environment only.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# Optional overrides; defaults are in backend/config.json and frontend/config.json.
# CATALOG_PATH=data/catalog.json
# FRONTEND_DIST_PATH=../frontend/dist
# CART_URL=/cart
# VITE_API_BASE_URL=/api

# Optional partner catalog adapter, independent of OpenAI.
# EKT_API_USERNAME=
# EKT_API_PASSWORD=
# EKT_PRODUCT_DETAIL_URL=https://ekt.kz/api/products/detail
