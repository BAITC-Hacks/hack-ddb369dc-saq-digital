{
  "name": "ekt-match-project",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.10.0" },
  "scripts": {
    "setup": "npm ci --prefix frontend && npm install --prefix backend --package-lock=false",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "start": "node --env-file-if-exists=.env backend/src/index.js",
    "preview": "npm start",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "docker:up": "docker compose up --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  }
}
